{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/apidocs",
      "destination": "https://aoe4-guides-api-7h2vti5ckq-ey.a.run.app/api-docs/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aoe4-guides-api-7h2vti5ckq-ey.a.run.app/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
